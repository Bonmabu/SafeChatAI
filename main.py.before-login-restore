@app.get("/attack-campaigns/{campaign_id}/investigation")
def attack_campaign_investigation(campaign_id: str):
    campaign = get_attack_campaign(campaign_id)

    if not campaign:
        return {
            "success": False,
            "error": "CAMPAIGN_NOT_FOUND",
            "campaign_id": campaign_id,
        }

    cluster_id = campaign.get("cluster_id")
    cluster = (
        get_correlation_cluster(cluster_id)
        if cluster_id
        else None
    )

    # ============================================================
    # PHASE 42.22 - CAMPAIGN RESPONSE HISTORY
    # Match response events by campaign_id OR by the authoritative
    # Fabric correlation IDs belonging to this campaign's members.
    # ============================================================
    response_events = []

    try:
        correlation_ids = set()

        for member in (cluster or {}).get("members", []):
            event_id = member.get("event_id")

            if not event_id:
                continue

            source_event = get_security_event(event_id)

            if source_event:
                correlation_id = source_event.get(
                    "correlation_id"
                )

                if correlation_id:
                    correlation_ids.add(
                        correlation_id
                    )

        fabric_events = get_security_events(
            limit=500,
            tenant_id=campaign.get("tenant_id")
        )

        for fabric_event in fabric_events:

            if fabric_event.get("event_type") != (
                "auto_response_event"
            ):
                continue

            same_campaign = (
                fabric_event.get("campaign_id")
                == campaign_id
            )

            same_correlation = (
                fabric_event.get("correlation_id")
                in correlation_ids
            )

            if same_campaign or same_correlation:
                response_events.append(
                    fabric_event
                )

    except Exception as response_error:
        print(
            "[42.22] Campaign response lookup failed:",
            response_error,
        )

    response_status = (
        "EXECUTED"
        if any(
            e.get("status") == "EXECUTED"
            for e in response_events
        )
        else (
            "BACKFILLED"
            if response_events
            else "NO_RESPONSE_RECORDED"
        )
    )

    investigation = {
        "campaign": campaign,
        "cluster": cluster,
        "timeline": get_campaign_timeline(campaign_id),

        "response": {
            "status": response_status,
            "event_count": len(response_events),
            "events": response_events,
        },

        "threat_dna": None,
        "attack_graph": None,
        "digital_twin": None,
        "replay": None,
        "links": {
            "campaign_id": campaign_id,
            "cluster_id": cluster_id,
        },
    }

    # ---------------------------------------------------------
    # Threat DNA
    # ---------------------------------------------------------
    try:
        from threat_dna import get_threat_dna

        getter = get_threat_dna

        try:
            investigation["threat_dna"] = getter(
                campaign.get("primary_category")
            )
        except TypeError:
            investigation["threat_dna"] = getter()

    except Exception as e:
        print("[42.18] Threat DNA unavailable:", e)

    # ---------------------------------------------------------
    # Attack Graph
    # ---------------------------------------------------------
    try:
        from attack_graph import get_graph

        investigation["attack_graph"] = get_graph()

    except Exception as e:
        print("[42.18] Attack Graph unavailable:", e)

    # ---------------------------------------------------------
    # Digital Twin
    # ---------------------------------------------------------
    try:
        from digital_twin import get_digital_twin_summary

        investigation["digital_twin"] = get_digital_twin_summary()

    except Exception as e:
        print("[42.18] Digital Twin unavailable:", e)

    # ---------------------------------------------------------
    # Threat Replay
    # ---------------------------------------------------------
    try:
        from replay_engine import build_replay, get_replay

        members = (
            (cluster or {}).get("members")
            or []
        )

        correlation_id = None

        for member in members:
            event_id = member.get("event_id")

            if event_id:
                correlation_id = event_id
                break

        if correlation_id:
            try:
                investigation["replay"] = get_replay(
                    correlation_id
                )
            except Exception:
                try:
                    investigation["replay"] = build_replay(
                        correlation_id
                    )
                except Exception as replay_error:
                    print(
                        "[42.18] Replay unavailable:",
                        replay_error
                    )

    except Exception as e:
        print("[42.18] Replay module unavailable:", e)

    return {
        "success": True,
        "investigation": investigation,
    }



