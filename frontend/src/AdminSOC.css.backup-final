/* =========================================================
   SAFECHAT AI Ã¢â‚¬â€ ADMIN SOC
   Premium Enterprise Security Operations UI
   ========================================================= */

.admin-soc-page {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24px;
  color: #e2e8f0;
  background:
    radial-gradient(
      circle at 85% 0%,
      rgba(0, 255, 200, 0.07),
      transparent 28%
    ),
    radial-gradient(
      circle at 10% 20%,
      rgba(59, 130, 246, 0.045),
      transparent 24%
    ),
    #020617;
}


/* =========================================================
   COMMAND HEADER
   ========================================================= */

.admin-command-header {
  position: relative;
  overflow: hidden;

  margin-bottom: 28px;
  padding: 30px;

  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 20px;

  background:
    linear-gradient(
      135deg,
      rgba(15, 23, 42, 0.98),
      rgba(7, 15, 30, 0.96)
    );

  box-shadow:
    0 24px 70px rgba(0, 0, 0, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.035);
}

.admin-header-glow {
  position: absolute;

  width: 300px;
  height: 300px;

  right: -120px;
  top: -180px;

  border-radius: 50%;

  background: rgba(0, 255, 200, 0.09);

  filter: blur(45px);

  pointer-events: none;
}

.admin-header-content {
  position: relative;
  z-index: 1;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 30px;
}


.admin-header-main {
  min-width: 0;
}


.admin-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;

  margin-bottom: 14px;

  padding: 6px 10px;

  border: 1px solid rgba(34, 197, 94, 0.18);
  border-radius: 999px;

  background: rgba(34, 197, 94, 0.06);

  color: #86efac;

  font-size: 10px;
  font-weight: 800;

  letter-spacing: 0.14em;
}


.admin-live-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #22c55e;

  box-shadow:
    0 0 0 4px rgba(34, 197, 94, 0.08),
    0 0 14px rgba(34, 197, 94, 0.9);
}


.admin-title {
  margin: 0;

  color: #f8fafc;

  font-size: clamp(28px, 3.5vw, 44px);
  line-height: 1.05;

  font-weight: 850;

  letter-spacing: -0.035em;
}


.admin-title-icon {
  margin-right: 12px;

  color: #00ffc8;

  filter:
    drop-shadow(0 0 12px rgba(0, 255, 200, 0.25));
}


.admin-title-muted {
  color: #94a3b8;
  font-weight: 600;
}


.admin-subtitle {
  max-width: 780px;

  margin: 13px 0 0;

  color: #64748b;

  font-size: 14px;
  line-height: 1.65;
}


/* =========================================================
   STATUS CARD
   ========================================================= */

.admin-status-card {
  display: flex;
  align-items: center;
  gap: 13px;

  min-width: 205px;

  padding: 15px 17px;

  border: 1px solid rgba(34, 197, 94, 0.14);
  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      rgba(15, 23, 42, 0.95),
      rgba(9, 20, 30, 0.9)
    );

  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.025);
}


.admin-status-icon {
  display: grid;
  place-items: center;

  width: 40px;
  height: 40px;

  border-radius: 11px;

  background: rgba(0, 255, 200, 0.07);

  color: #00ffc8;

  font-size: 18px;
}


.admin-status-label {
  margin-bottom: 4px;

  color: #64748b;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 0.12em;
  text-transform: uppercase;
}


.admin-status-value {
  display: flex;
  align-items: center;
  gap: 7px;

  color: #4ade80;

  font-size: 12px;
  font-weight: 850;

  letter-spacing: 0.06em;
}


.admin-status-value span {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #22c55e;

  box-shadow: 0 0 10px rgba(34, 197, 94, 0.8);
}


/* =========================================================
   HEADER META
   ========================================================= */

.admin-header-meta {
  position: relative;
  z-index: 1;

  display: flex;
  align-items: center;

  gap: 18px;

  margin-top: 26px;
  padding-top: 18px;

  border-top: 1px solid rgba(148, 163, 184, 0.08);
}


.admin-meta-item {
  display: flex;
  flex-direction: column;
  gap: 3px;
}


.admin-meta-label {
  color: #475569;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: 0.13em;
}


.admin-meta-item strong {
  color: #cbd5e1;

  font-size: 10px;
  font-weight: 800;

  letter-spacing: 0.07em;
}


.admin-meta-divider {
  width: 1px;
  height: 28px;

  background: rgba(148, 163, 184, 0.10);
}


.admin-meta-spacer {
  flex: 1;
}


.admin-secure-badge {
  display: flex;
  align-items: center;
  gap: 7px;

  padding: 7px 10px;

  border: 1px solid rgba(0, 255, 200, 0.12);
  border-radius: 8px;

  background: rgba(0, 255, 200, 0.035);

  color: #64748b;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 0.08em;
}


.admin-secure-badge span {
  color: #00ffc8;
  font-size: 8px;
}


/* =========================================================
   SECTIONS
   ========================================================= */

.admin-section {
  margin-bottom: 30px;
}


.admin-section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 14px;
}


.admin-section-heading.compact {
  margin-bottom: 16px;
}


.admin-section-kicker {
  display: block;

  margin-bottom: 6px;

  color: #00bfa5;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 0.15em;
}


.admin-section-heading h2 {
  margin: 0;

  color: #f8fafc;

  font-size: 21px;
  font-weight: 750;

  letter-spacing: -0.02em;
}


.admin-section-heading p {
  margin: 5px 0 0;

  color: #64748b;

  font-size: 12px;
}


.admin-section-indicator {
  display: flex;
  align-items: center;
  gap: 7px;

  padding: 6px 9px;

  border: 1px solid rgba(34, 197, 94, 0.12);
  border-radius: 7px;

  background: rgba(34, 197, 94, 0.045);

  color: #4ade80;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 0.1em;
}


.admin-section-indicator span {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #22c55e;

  box-shadow: 0 0 9px rgba(34, 197, 94, 0.7);
}


/* =========================================================
   CONTENT PANELS
   ========================================================= */

.admin-app-panel,
.admin-metrics-panel,
.admin-directory-panel {
  position: relative;

  border: 1px solid rgba(148, 163, 184, 0.09);
  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      rgba(15, 23, 42, 0.82),
      rgba(7, 14, 28, 0.92)
    );

  box-shadow:
    0 18px 50px rgba(0, 0, 0, 0.20),
    inset 0 1px 0 rgba(255, 255, 255, 0.025);

  overflow: hidden;
}


.admin-app-panel {
  padding: 4px;
}


.admin-metrics-panel {
  padding: 4px;
  margin-bottom: 18px;
}


.admin-directory-panel {
  padding: 4px;
}


/* =========================================================
   FOOTER
   ========================================================= */

.admin-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-top: 35px;
  padding: 18px 4px 8px;

  border-top: 1px solid rgba(148, 163, 184, 0.07);

  color: #475569;

  font-size: 10px;
}


.admin-footer strong {
  margin-right: 8px;

  color: #64748b;

  font-weight: 800;
}


.admin-footer-status {
  display: flex;
  align-items: center;
  gap: 7px;
}


.admin-footer-status span {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #22c55e;

  box-shadow: 0 0 8px rgba(34, 197, 94, 0.7);
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 900px) {

  .admin-soc-page {
    padding: 16px;
  }

  .admin-header-content {
    flex-direction: column;
    align-items: flex-start;
  }

  .admin-status-card {
    width: 100%;
    box-sizing: border-box;
  }

}


@media (max-width: 650px) {

  .admin-soc-page {
    padding: 10px;
  }

  .admin-command-header {
    padding: 22px;
    border-radius: 16px;
  }

  .admin-title {
    font-size: 29px;
  }

  .admin-title-muted {
    display: block;
    margin-top: 4px;
  }

  .admin-header-meta {
    flex-wrap: wrap;
    gap: 12px;
  }

  .admin-meta-spacer {
    display: none;
  }

  .admin-secure-badge {
    width: 100%;
    justify-content: center;
  }

  .admin-section-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-footer {
    flex-direction: column;
    align-items: flex-start;
  }

}
/* =========================================================
   ADMIN SOC Ã¢â‚¬â€ PREMIUM OPERATIONS MODULES
   Incident Management / Threat Timeline / AI Intel / Reports
   ========================================================= */

.admin-section {
  margin-bottom: 32px;
}

/* SECTION HEADINGS */

.admin-section-heading {
  margin-bottom: 16px;
}

.admin-section-heading h2 {
  color: #f8fafc;
  font-size: 21px;
  font-weight: 800;
  letter-spacing: -0.025em;
}

.admin-section-heading p {
  margin-top: 6px;
  color: #64748b;
  font-size: 12px;
}

/* =========================================================
   INCIDENT MANAGEMENT
   ========================================================= */

.admin-incidents,
.incident-management,
.admin-incident-panel {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, 0.10);
  border-radius: 20px;
  background:
    linear-gradient(
      145deg,
      rgba(15, 23, 42, 0.96),
      rgba(7, 14, 28, 0.94)
    );
  box-shadow:
    0 20px 55px rgba(0, 0, 0, 0.22),
    inset 0 1px 0 rgba(255,255,255,0.025);
}

/* FILTER BAR */

.admin-incidents .filters,
.incident-filters,
.admin-incident-filters {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  padding: 15px 18px;
  border-bottom: 1px solid rgba(148,163,184,0.08);
  background: rgba(2,6,23,0.35);
}

.incident-filters button,
.admin-incident-filters button,
.admin-incidents button {
  border: 1px solid rgba(148,163,184,0.10);
  border-radius: 9px;
  padding: 7px 11px;
  background: rgba(15,23,42,0.75);
  color: #94a3b8;
  font-size: 10px;
  font-weight: 750;
  cursor: pointer;
  transition: all .18s ease;
}

.incident-filters button:hover,
.admin-incident-filters button:hover,
.admin-incidents button:hover {
  border-color: rgba(0,255,200,.25);
  color: #00ffc8;
  background: rgba(0,255,200,.05);
}

.incident-filters button.active,
.admin-incident-filters button.active {
  border-color: rgba(0,255,200,.30);
  background: rgba(0,255,200,.08);
  color: #00ffc8;
}

/* INCIDENT TABLE */

.admin-incidents table,
.incident-management table,
.admin-incident-panel table {
  width: 100%;
  border-collapse: collapse;
}

.admin-incidents thead,
.incident-management thead,
.admin-incident-panel thead {
  background: rgba(2,6,23,.55);
}

.admin-incidents th,
.incident-management th,
.admin-incident-panel th {
  padding: 12px 15px;
  border-bottom: 1px solid rgba(148,163,184,.08);
  color: #64748b;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .10em;
  text-align: left;
  text-transform: uppercase;
}

.admin-incidents td,
.incident-management td,
.admin-incident-panel td {
  padding: 13px 15px;
  border-bottom: 1px solid rgba(148,163,184,.055);
  color: #cbd5e1;
  font-size: 11px;
  transition: background .15s ease;
}

.admin-incidents tbody tr:hover,
.incident-management tbody tr:hover,
.admin-incident-panel tbody tr:hover {
  background: rgba(0,255,200,.025);
}

.admin-incidents tbody tr:last-child td,
.incident-management tbody tr:last-child td,
.admin-incident-panel tbody tr:last-child td {
  border-bottom: none;
}

/* STATUS BADGES */

.admin-incidents td:nth-child(3),
.incident-management td:nth-child(3) {
  font-weight: 800;
}

.admin-incidents td:nth-child(4),
.incident-management td:nth-child(4) {
  color: #4ade80;
  font-weight: 800;
  letter-spacing: .04em;
}

/* ACTION BUTTONS */

.admin-incidents td:last-child button,
.incident-management td:last-child button {
  width: 30px;
  height: 30px;
  margin-right: 5px;
  padding: 0;
  border-radius: 8px;
  border: 1px solid rgba(148,163,184,.10);
  background: rgba(15,23,42,.8);
  transition: .18s ease;
}

.admin-incidents td:last-child button:hover,
.incident-management td:last-child button:hover {
  transform: translateY(-1px);
  border-color: rgba(0,255,200,.25);
  background: rgba(0,255,200,.07);
}

/* =========================================================
   THREAT TIMELINE
   ========================================================= */

.admin-threat-timeline,
.threat-timeline,
.timeline-panel {
  position: relative;
  overflow: hidden;
  min-height: 170px;
  padding: 20px;
  border: 1px solid rgba(148,163,184,.10);
  border-radius: 20px;
  background:
    radial-gradient(
      circle at 80% 30%,
      rgba(0,255,200,.045),
      transparent 30%
    ),
    linear-gradient(
      145deg,
      rgba(15,23,42,.95),
      rgba(7,14,28,.95)
    );
  box-shadow:
    0 20px 50px rgba(0,0,0,.20),
    inset 0 1px 0 rgba(255,255,255,.025);
}

/* timeline line */

.admin-threat-timeline::before,
.threat-timeline::before,
.timeline-panel::before {
  content: "";
  position: absolute;
  top: 58px;
  left: 30px;
  right: 30px;
  height: 1px;
  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(0,255,200,.25),
      rgba(59,130,246,.22),
      transparent
    );
}

/* =========================================================
   AI THREAT INTELLIGENCE
   ========================================================= */

.admin-ai-intelligence,
.ai-threat-intelligence,
.threat-intelligence-panel {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  position: relative;
  overflow: hidden;
  padding: 18px;
  border: 1px solid rgba(148,163,184,.10);
  border-radius: 20px;
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(0,255,200,.055),
      transparent 34%
    ),
    linear-gradient(
      145deg,
      rgba(15,23,42,.97),
      rgba(7,14,28,.95)
    );
  box-shadow:
    0 20px 55px rgba(0,0,0,.22),
    inset 0 1px 0 rgba(255,255,255,.025);
}

/* INTEL CARDS */

.admin-ai-intelligence > div,
.ai-threat-intelligence > div,
.threat-intelligence-panel > div {
  min-height: 125px;
  padding: 18px;
  border: 1px solid rgba(148,163,184,.08);
  border-radius: 15px;
  background: rgba(2,6,23,.38);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.025);
}

.admin-ai-intelligence h4,
.ai-threat-intelligence h4,
.threat-intelligence-panel h4 {
  margin: 0 0 12px;
  color: #64748b;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.admin-ai-intelligence h3,
.ai-threat-intelligence h3,
.threat-intelligence-panel h3 {
  margin: 0;
  color: #f8fafc;
  font-size: 28px;
  font-weight: 850;
  letter-spacing: -.04em;
}

.admin-ai-intelligence .decision,
.ai-threat-intelligence .decision,
.threat-intelligence-panel .decision {
  color: #fb7185;
}

/* FORECAST STRIP */

.breach-forecast,
.prediction-window,
.threat-trend {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
  padding: 6px 9px;
  border-radius: 8px;
  background: rgba(248,113,113,.07);
  border: 1px solid rgba(248,113,113,.12);
  color: #fda4af;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .06em;
}

/* =========================================================
   INCIDENT REPORTS
   ========================================================= */

.admin-reports,
.incident-reports,
.admin-report-panel {
  overflow: hidden;
  border: 1px solid rgba(148,163,184,.10);
  border-radius: 20px;
  background:
    linear-gradient(
      145deg,
      rgba(15,23,42,.96),
      rgba(7,14,28,.94)
    );
  box-shadow:
    0 20px 50px rgba(0,0,0,.20),
    inset 0 1px 0 rgba(255,255,255,.025);
}

/* REPORT ACTION BAR */

.admin-report-actions,
.report-actions,
.incident-report-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  padding: 14px 18px;
  border-bottom: 1px solid rgba(148,163,184,.08);
}

.admin-report-actions button,
.report-actions button,
.incident-report-actions button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border: 1px solid rgba(148,163,184,.12);
  border-radius: 9px;
  padding: 8px 12px;
  background: rgba(15,23,42,.8);
  color: #cbd5e1;
  font-size: 10px;
  font-weight: 800;
  cursor: pointer;
  transition: .18s ease;
}

.admin-report-actions button:hover,
.report-actions button:hover,
.incident-report-actions button:hover {
  border-color: rgba(0,255,200,.25);
  background: rgba(0,255,200,.06);
  color: #00ffc8;
}

/* REPORT TABLE */

.admin-reports table,
.incident-reports table,
.admin-report-panel table {
  width: 100%;
  border-collapse: collapse;
}

.admin-reports th,
.incident-reports th,
.admin-report-panel th {
  padding: 11px 15px;
  color: #64748b;
  background: rgba(2,6,23,.45);
  border-bottom: 1px solid rgba(148,163,184,.08);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .09em;
  text-align: left;
  text-transform: uppercase;
}

.admin-reports td,
.incident-reports td,
.admin-report-panel td {
  padding: 11px 15px;
  border-bottom: 1px solid rgba(148,163,184,.055);
  color: #94a3b8;
  font-size: 10px;
}

.admin-reports tbody tr:hover,
.incident-reports tbody tr:hover,
.admin-report-panel tbody tr:hover {
  background: rgba(59,130,246,.025);
}

/* =========================================================
   PAGINATION
   ========================================================= */

.admin-pagination,
.pagination,
.table-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 15px;
  border-top: 1px solid rgba(148,163,184,.06);
}

.admin-pagination button,
.pagination button,
.table-pagination button {
  min-width: 32px;
  height: 30px;
  border: 1px solid rgba(148,163,184,.10);
  border-radius: 8px;
  background: rgba(15,23,42,.8);
  color: #94a3b8;
  font-size: 10px;
  cursor: pointer;
}

.admin-pagination button:hover,
.pagination button:hover,
.table-pagination button:hover {
  border-color: rgba(0,255,200,.25);
  color: #00ffc8;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 900px) {
  .admin-ai-intelligence,
  .ai-threat-intelligence,
  .threat-intelligence-panel {
    grid-template-columns: 1fr;
  }

  .admin-incidents,
  .incident-management,
  .admin-incident-panel,
  .admin-reports,
  .incident-reports,
  .admin-report-panel {
    overflow-x: auto;
  }

  .admin-incidents table,
  .incident-management table,
  .admin-incident-panel table,
  .admin-reports table,
  .incident-reports table,
  .admin-report-panel table {
    min-width: 720px;
  }
}

@media (max-width: 600px) {
  .admin-report-actions,
  .report-actions,
  .incident-report-actions {
    justify-content: flex-start;
    flex-wrap: wrap;
  }

  .admin-ai-intelligence,
  .ai-threat-intelligence,
  .threat-intelligence-panel {
    padding: 12px;
  }
}


/* =========================================================
   INCIDENT REPORTS - COMPACT INTERNAL SCROLL
   ========================================================= */

.admin-soc-module-card table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
}

/* The report rows scroll INSIDE the card */
.admin-soc-module-card table tbody {
  display: block;
  max-height: 360px;
  overflow-y: auto;
  overflow-x: hidden;
}

/* Keep header and rows aligned */
.admin-soc-module-card table thead,
.admin-soc-module-card table tbody tr {
  width: 100%;
  table-layout: fixed;
}

.admin-soc-module-card table thead {
  display: table;
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(15, 23, 42, 0.98);
}

.admin-soc-module-card table tbody tr {
  display: table;
}

/* Compact rows */
.admin-soc-module-card table th,
.admin-soc-module-card table td {
  padding: 9px 12px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Internal scrollbar */
.admin-soc-module-card table tbody::-webkit-scrollbar {
  width: 6px;
}

.admin-soc-module-card table tbody::-webkit-scrollbar-track {
  background: rgba(15, 23, 42, 0.5);
}

.admin-soc-module-card table tbody::-webkit-scrollbar-thumb {
  background: rgba(100, 116, 139, 0.55);
  border-radius: 10px;
}

.admin-soc-module-card table tbody::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 255, 200, 0.65);
}

/* Firefox */
.admin-soc-module-card table tbody {
  scrollbar-width: thin;
  scrollbar-color: rgba(100, 116, 139, 0.55) rgba(15, 23, 42, 0.5);
}

/* Reduce spacing around the report module */
.admin-soc-module {
  margin-bottom: 18px;
}

@media (max-width: 700px) {
  .admin-soc-module-card table tbody {
    max-height: 300px;
  }

  .admin-soc-module-card table th,
  .admin-soc-module-card table td {
    padding: 8px;
    font-size: 11px;
  }
}
